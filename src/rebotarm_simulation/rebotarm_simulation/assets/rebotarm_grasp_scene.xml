<?xml version="1.0" encoding="utf-8"?>
<!-- 本项目自有的 Apache-2.0 MuJoCo 抓取场景，未使用任何外部 HJX 资产。
     结构：引用机器人模型 + 地面 + 一个可自由运动的被抓取方块 + 初始关键帧。
     长度单位 m、角度 rad；被引用模型的控制量由模型档位构建流程注入。 -->
<mujoco model="reBotArm_grasp_scene">
  <!-- 机器人本体来自同目录的基线模型；运行时该相对路径会被替换成绝对路径，
       因此本文件可放在任意构建目录中执行。 -->
  <include file="rebotarm_base.xml"/>
  <worldbody>
    <!-- 两盏方向光：从相反方向补光，保证离屏渲染时物体轮廓与阴影都可辨识。 -->
    <light directional="true" diffuse="0.4 0.4 0.4" pos="-1 -1 1" dir="1 1 -1"/>
    <light directional="true" diffuse="0.3 0.3 0.3" pos="1 -1 1" dir="-1 1 -1"/>
    <!-- 地面：无限平面，size 前两项为可视/碰撞范围（m），摩擦系数依次为
         滑动、扭转、滚动摩擦；浅灰 rgba 便于观察方块位置。 -->
    <geom name="floor" type="plane" size="2 2 0.1" friction="1.0 0.1 0.01" rgba="0.75 0.75 0.75 1"/>
    <!-- 被抓取方块：freejoint 表示六自由度自由体（会随重力下落、可被夹爪带走）。
         pos 为质心初始位置，size 为半边长（0.02 m，即 2 cm 立方体，底面初始离地 0.03 m），
         mass 0.025 kg、diaginertia 为对角惯量（kg·m²）。
         condim=4 启用滑动+扭转摩擦，配合高滑动摩擦 1.0 才能被稳定夹持。 -->
    <body name="box" pos="0.5 0 0.05">
      <freejoint name="red_box_joint"/>
      <inertial pos="0 0 0" mass="0.025" diaginertia="0.002 0.002 0.002"/>
      <geom name="red_box" type="box" size="0.02 0.02 0.02" friction="1 0.005 0.0001" condim="4" rgba="1 0 0 1"/>
    </body>
  </worldbody>
  <keyframe>
    <!-- 初始关键帧 "0"，用于一键复位到抓取试验起点。
         qpos 共 15 个数：0~5 为机械臂六个关节角（rad），6~7 为左右手指滑移量
         （0.035 / -0.035 → 开口 0.07 m），8~14 为方块的自由关节
         （xyz = 0.5 0 0.05，四元数 wxyz = 1 0 0 0）。
         ctrl 共 7 个数：六个臂关节目标角 + 夹爪（左指）目标位置，与 qpos 前 7 项一致，
         避免复位瞬间执行器产生大跳变。 -->
    <key name="0" qpos="0 -0.8 -1.2 0.6 0 0 0.035 -0.035 0.5 0 0.05 1 0 0 0" ctrl="0 -0.8 -1.2 0.6 0 0 0.035"/>
  </keyframe>
</mujoco>
