Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
      Reference Frame: base_link
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
        camera_depth_frame:
          Value: true
        end_link:
          Value: true
        grasp_tcp:
          Value: true
      Marker Scale: 0.08
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        base_link:
          {}
      Update Interval: 0
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Value: /grasp/visual_markers
      Name: Visual Grasp Markers
      Namespaces:
        {}
      Queue Size: 10
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 1.2
    Focal Point:
      X: 0.35
      Y: 0
      Z: 0.18
    Name: Current View
    Pitch: 0.65
    Target Frame: base_link
    Yaw: 3.14
  Saved: ~
Window Geometry:
  Height: 820
  Width: 1180
