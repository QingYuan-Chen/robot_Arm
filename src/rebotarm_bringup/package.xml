<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rebotarm_bringup</name>
  <version>0.1.0</version>
  <description>Launch, configuration, and description files for reBotArm.</description>
  <maintainer email="support@example.com">reBotArm Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rebotarm_calibration</exec_depend>
  <exec_depend>rebotarm_dashboard</exec_depend>
  <exec_depend>rebotarm_motion</exec_depend>
  <exec_depend>rebotarm_moveit_config</exec_depend>
  <exec_depend>rebotarm_simulation</exec_depend>
  <exec_depend>rebotarm_teach</exec_depend>
  <exec_depend>rebotarm_teleop</exec_depend>
  <exec_depend>rebotarm_vision</exec_depend>
  <exec_depend>rebotarmcontroller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
