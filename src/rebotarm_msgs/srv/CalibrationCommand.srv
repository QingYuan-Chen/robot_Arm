# Read-only calibration workflow; never a robot motion command.
# command: create/status/preview/tf_check/preflight/capture/solve/reopen/accept/abort
string command
string session_id
string request_id
int64 expected_revision
# Versioned JSON object. Capture payload contains split only; observations
# are generated by the calibration node, never trusted from the browser.
string payload_json
---
bool success
string reason_code
string message
string session_json
