+
+    fn bus() -> Arc<dyn CanBus> {
+        Arc::new(NoopBus)
+    }
+
+    fn damiao_handle_without_state() -> MotorHandle {
+        let motor = DamiaoMotor::new(0x01, 0x11, "4340P", bus()).expect("create Damiao motor");
+        MotorHandle {
+            inner: Mutex::new(MotorHandleInner::Damiao(Arc::new(motor))),
+        }
+    }
+
+    fn last_error_text() -> String {
+        crate::LAST_ERROR.with(|slot| slot.borrow().to_string_lossy().into_owned())
+    }
+
+    #[test]
+    fn get_state_with_sequence_rejects_each_null_pointer() {
+        let mut handle = damiao_handle_without_state();
+        let mut state = MotorState::default();
