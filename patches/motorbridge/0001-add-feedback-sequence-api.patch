+    #[test]
+    fn identical_feedback_frames_advance_sequence() {
+        let bus: Arc<dyn CanBus> = Arc::new(MockBus::new());
+        let motor = DamiaoMotor::new(0x01, 0x11, "4340P", bus).expect("create motor");
+        let frame = CanFrame {
+            arbitration_id: 0x11,
+            data: [0x11, 0x80, 0x00, 0x80, 0x00, 0x80, 55, 44],
+            dlc: 8,
+            is_extended: false,
+            is_rx: true,
+        };
+
+        motor
+            .process_feedback_frame_impl(frame)
+            .expect("process first sensor frame");
+        let (first, first_sequence) = motor
+            .latest_state_with_sequence()
+            .expect("first state and sequence");
+
+        motor
+            .process_feedback_frame_impl(frame)
+            .expect("process identical second sensor frame");
+        let (second, second_sequence) = motor
+            .latest_state_with_sequence()
+            .expect("second state and sequence");
+
+        assert_eq!(first_sequence, 1);
+        assert_eq!(second_sequence, 2);
+        assert_eq!(
+            (
+                first.can_id,
+                first.arbitration_id,
+                first.status_code,
+                first.pos.to_bits(),
+                first.vel.to_bits(),
+                first.torq.to_bits(),
+                first.t_mos.to_bits(),
+                first.t_rotor.to_bits(),
+            ),
+            (
+                second.can_id,
+                second.arbitration_id,
+                second.status_code,
+                second.pos.to_bits(),
+                second.vel.to_bits(),
+                second.torq.to_bits(),
+                second.t_mos.to_bits(),
+                second.t_rotor.to_bits(),
+            ),
+        );
+    }
