+from __future__ import annotations
+
+import ctypes
+from types import SimpleNamespace
+
+from motorbridge.abi import Abi, CState
+from motorbridge.core import Motor
+
+
+class FakeAbiLibrary:
+    def motor_handle_get_state_with_sequence(
+        self,
+        motor: int,
+        out_state: object,
+        out_sequence: object,
+    ) -> int:
+        assert motor == 123
+        state = ctypes.cast(out_state, ctypes.POINTER(CState)).contents
+        state.has_value = 1
+        state.can_id = 1
+        state.arbitration_id = 0x11
+        state.status_code = 1
+        state.pos = 1.25
+        state.vel = 2.5
+        state.torq = 0.75
+        state.t_mos = 35.0
+        state.t_rotor = 34.0
+        sequence = ctypes.cast(out_sequence, ctypes.POINTER(ctypes.c_uint64)).contents
+        sequence.value = ctypes.c_uint64(7).value
+        return 0
+
+
+class FakeBindingFunction:
+    argtypes: list[object] | None = None
+    restype: object | None = None
+
+
+class FakeBindingLibrary:
+    def __getattr__(self, name: str) -> FakeBindingFunction:
+        function = FakeBindingFunction()
+        setattr(self, name, function)
+        return function
+
+
+def test_get_state_with_sequence_returns_state_and_receive_identity() -> None:
+    motor = Motor.__new__(Motor)
+    motor._abi = SimpleNamespace(lib=FakeAbiLibrary())
+    motor._ptr = 123
+
+    state, sequence = motor.get_state_with_sequence()
+
+    assert state is not None
+    assert state.pos == 1.25
+    assert sequence == 7
+
+
+def test_abi_bind_types_feedback_sequence_symbol() -> None:
+    abi = Abi.__new__(Abi)
+    abi.lib = FakeBindingLibrary()
+
+    abi._bind()
+
+    symbol = abi.lib.motor_handle_get_state_with_sequence
+    assert symbol.argtypes == [
+        ctypes.c_void_p,
+        ctypes.POINTER(CState),
+        ctypes.POINTER(ctypes.c_uint64),
+    ]
+    assert symbol.restype is ctypes.c_int32
