+#[unsafe(no_mangle)]
+pub extern "C" fn motor_handle_get_state_with_sequence(
+    motor: *mut MotorHandle,
+    out_state: *mut MotorState,
+    out_sequence: *mut u64,
+) -> i32 {
+    if motor.is_null() || out_state.is_null() || out_sequence.is_null() {
+        set_last_error("motor, out_state, or out_sequence is null");
+        return -1;
+    }
+    let motor = lock_motor_inner!(motor, "motor is null");
+    let out = unsafe { &mut *out_state };
+    let sequence = unsafe { &mut *out_sequence };
+    match &*motor {
+        MotorHandleInner::Damiao(m) => {
+            if let Some((state, state_sequence)) = m.latest_state_with_sequence() {
+                *out = MotorState {
+                    has_value: 1,
+                    can_id: state.can_id,
+                    arbitration_id: state.arbitration_id,
+                    status_code: state.status_code,
+                    pos: state.pos,
+                    vel: state.vel,
+                    torq: state.torq,
+                    t_mos: state.t_mos,
+                    t_rotor: state.t_rotor,
+                };
+                *sequence = state_sequence;
+            } else {
+                *out = MotorState::default();
+                *sequence = 0;
+            }
+        }
+        _ => {
+            set_last_error(
+                "motor_handle_get_state_with_sequence is only supported for Damiao motors",
+            );
+            return -1;
+        }
+    }
+    0
+}
+
