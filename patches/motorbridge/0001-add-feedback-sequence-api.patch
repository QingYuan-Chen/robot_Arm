+        let mut handle = MotorHandle {
+            inner: Mutex::new(MotorHandleInner::MyActuator(Arc::new(motor))),
+        };
+        let mut state = MotorState::default();
+        let mut sequence = 0;
+
+        assert_eq!(
+            motor_handle_get_state_with_sequence(&mut handle, &mut state, &mut sequence),
+            -1,
+        );
+        assert_eq!(
+            last_error_text(),
+            "motor_handle_get_state_with_sequence is only supported for Damiao motors",
