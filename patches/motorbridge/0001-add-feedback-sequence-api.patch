+            -1,
+        );
+        assert!(last_error_text().contains("motor, out_state, or out_sequence is null"));
+
+        assert_eq!(
+            motor_handle_get_state_with_sequence(&mut handle, &mut state, ptr::null_mut()),
+            -1,
+        );
+        assert!(last_error_text().contains("motor, out_state, or out_sequence is null"));
+    }
+
+    #[test]
+    fn get_state_with_sequence_returns_empty_state_and_zero_before_first_frame() {
+        let mut handle = damiao_handle_without_state();
+        let mut state = MotorState {
+            has_value: 1,
+            can_id: 9,
+            arbitration_id: 9,
+            status_code: 9,
+            pos: 9.0,
+            vel: 9.0,
+            torq: 9.0,
+            t_mos: 9.0,
+            t_rotor: 9.0,
+        };
+        let mut sequence = 99;
+
+        assert_eq!(
+            motor_handle_get_state_with_sequence(&mut handle, &mut state, &mut sequence),
+            0,
+        );
+        assert_eq!(state.has_value, 0);
+        assert_eq!(state.can_id, 0);
+        assert_eq!(state.arbitration_id, 0);
+        assert_eq!(state.status_code, 0);
+        assert_eq!(state.pos, 0.0);
+        assert_eq!(state.vel, 0.0);
+        assert_eq!(state.torq, 0.0);
+        assert_eq!(state.t_mos, 0.0);
+        assert_eq!(state.t_rotor, 0.0);
+        assert_eq!(sequence, 0);
+    }
+
+    #[test]
